{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "place.schema.json",
  "title": "Place",
  "description": "A playground, indoor playground or eatery in the directory.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "kind", "tags", "sources", "last_verified"],
  "properties": {
    "id": { "type": "string", "pattern": "^pl_[0-9a-f]{12}$" },
    "name": { "type": "string", "minLength": 2, "maxLength": 160 },
    "kind": { "enum": ["playground", "indoor_playground", "restaurant", "cafe"] },
    "summary": { "type": ["string", "null"], "maxLength": 280 },
    "address": { "type": ["string", "null"] },
    "region": { "$ref": "#/$defs/region" },
    "lat": { "type": ["number", "null"], "minimum": 1.15, "maximum": 1.48 },
    "lng": { "type": ["number", "null"], "minimum": 103.6, "maximum": 104.1 },
    "tags": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "water_play",
          "shaded",
          "sheltered",
          "toddler_zone",
          "sand",
          "stroller_friendly",
          "toilets_nearby",
          "nursing_room",
          "baby_changing",
          "parking",
          "near_mrt",
          "air_conditioned",
          "play_area",
          "kids_menu",
          "high_chairs",
          "free",
          "paid"
        ]
      }
    },
    "price_text": { "type": ["string", "null"], "maxLength": 160 },
    "hours_text": { "type": ["string", "null"], "maxLength": 200 },
    "closed_text": { "type": ["string", "null"], "maxLength": 200 },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/sourceRef" }
    },
    "last_verified": { "$ref": "#/$defs/date" }
  },
  "$defs": {
    "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$", "format": "date" },
    "region": { "enum": ["central", "east", "north", "north_east", "west", null] },
    "sourceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "url"],
      "properties": {
        "source_id": { "type": "string" },
        "url": { "type": "string", "minLength": 8 },
        "article_title": { "type": ["string", "null"] },
        "published": { "oneOf": [{ "$ref": "#/$defs/date" }, { "type": "null" }] }
      }
    }
  }
}
