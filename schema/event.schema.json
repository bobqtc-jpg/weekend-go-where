{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "event.schema.json",
  "title": "Event",
  "description": "A dated, kid-relevant happening extracted from a source article.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "summary",
    "fit",
    "category",
    "venue",
    "dates",
    "audience",
    "cost",
    "setting",
    "sources",
    "first_seen",
    "last_seen"
  ],
  "properties": {
    "id": { "type": "string", "pattern": "^ev_[0-9a-f]{12}$" },
    "title": { "type": "string", "minLength": 3, "maxLength": 160 },
    "summary": {
      "type": "string",
      "minLength": 10,
      "maxLength": 280,
      "description": "One or two sentences in our own words, never copied from the source."
    },
    "fit": {
      "enum": ["great", "ok", "low"],
      "description": "How well it suits this household (a child of about 2½ and two parents): great = made for young children or something a toddler enjoys for its own sake; ok = a toddler can come along and there is something for them; low = not a toddler outing. Judged at extraction; low events are hidden by default."
    },
    "category": {
      "enum": [
        "performance",
        "workshop",
        "festival",
        "exhibition",
        "play",
        "nature",
        "sport",
        "market",
        "holiday_programme",
        "storytelling",
        "other"
      ]
    },
    "venue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "minLength": 2 },
        "address": { "type": ["string", "null"] },
        "region": { "$ref": "#/$defs/region" },
        "lat": { "type": ["number", "null"], "minimum": 1.15, "maximum": 1.48 },
        "lng": { "type": ["number", "null"], "minimum": 103.6, "maximum": 104.1 }
      }
    },
    "dates": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end"],
      "properties": {
        "start": { "$ref": "#/$defs/date" },
        "end": { "$ref": "#/$defs/date" },
        "pattern": {
          "enum": ["fixed", "recurring", "open_ended"],
          "description": "fixed: stated start and end (one-off or a run); recurring: repeats on a schedule with no near end, dated only for the period the article covers; open_ended: no end stated, so end is a placeholder. Missing means fixed."
        },
        "times": { "type": ["string", "null"], "maxLength": 120 },
        "slots": {
          "type": "array",
          "uniqueItems": true,
          "items": { "enum": ["morning", "afternoon", "evening"] },
          "description": "Parts of the day it runs: morning before 12pm, afternoon 12pm to 6pm, evening from 6pm. Empty when the times are not stated."
        },
        "days": {
          "type": "array",
          "uniqueItems": true,
          "items": { "enum": ["mon", "tue", "wed", "thu", "fri", "sat", "sun"] },
          "description": "Days it runs within the range; empty means every day or not stated."
        }
      }
    },
    "audience": {
      "type": "object",
      "additionalProperties": false,
      "required": ["toddler_ok"],
      "properties": {
        "age_min": { "type": ["number", "null"], "minimum": 0, "maximum": 18 },
        "age_max": { "type": ["number", "null"], "minimum": 0, "maximum": 18 },
        "toddler_ok": { "enum": ["yes", "no", "unclear"] }
      }
    },
    "cost": {
      "type": "object",
      "additionalProperties": false,
      "required": ["is_free"],
      "properties": {
        "is_free": { "type": ["boolean", "null"] },
        "price_text": { "type": ["string", "null"], "maxLength": 160 },
        "min_sgd": { "type": ["number", "null"], "minimum": 0 }
      }
    },
    "booking": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "required": { "type": ["boolean", "null"] },
        "status": {
          "enum": ["open", "registration_required", "fully_booked", null],
          "description": "As stated by the source: open, registration needed with spaces left, or fully booked."
        },
        "url": { "type": ["string", "null"] },
        "opens": { "oneOf": [{ "$ref": "#/$defs/date" }, { "type": "null" }] }
      }
    },
    "setting": { "enum": ["indoor", "outdoor", "mixed", "unclear"] },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/sourceRef" }
    },
    "first_seen": { "$ref": "#/$defs/date" },
    "last_seen": { "$ref": "#/$defs/date" },
    "notes": { "type": ["string", "null"], "maxLength": 400 }
  },
  "$defs": {
    "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$", "format": "date" },
    "region": { "enum": ["central", "east", "north", "north_east", "west", null] },
    "sourceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "url"],
      "properties": {
        "source_id": { "type": "string" },
        "url": { "type": "string", "minLength": 8 },
        "article_title": { "type": ["string", "null"] },
        "published": { "oneOf": [{ "$ref": "#/$defs/date" }, { "type": "null" }] }
      }
    }
  }
}
